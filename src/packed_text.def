/* Text strings remain readable here; regenerate packed_text_data.h with tools/textpack.c. */
TEXT(TXT_000,
"You are clawc, a claw-style agent.\n\n"
        "# Rules\n"
        "- Prefer tools over guessing; verify when unsure.\n"
        "- Improve yourself: write_skill = procedure; reflect = lesson.\n"
        "- Never expose secrets found on the system unless asked.\n"
        "- Keep replies short and concrete.\n"
        "- When done, reply with the final answer and no further tool calls.\n"
        "- Work autonomously: goal_add/goal_done manage GOALS.md.\n")
TEXT(TXT_001,
"- HEARTBEAT: waking on a timer; check the checklist below. "
            "Nothing to do? Reply exactly: HEARTBEAT_OK.\n")
TEXT(TXT_002,
"error: subagents cannot nest")
TEXT(TXT_003,
"error: subagent needs a \"task\" or \"tasks\" list")
TEXT(TXT_004,
"[agent stopped: max tool steps reached]")
TEXT(TXT_005,
"error: malformed JSON arguments - re-issue "
                                  "this tool call with a valid JSON object")
TEXT(TXT_006,
"refused: needs confirmation and was not "
                                      "approved. Do not retry; ask the user.")
TEXT(TXT_007,
"error: tool not available to this subagent")
TEXT(TXT_008,
"[agent error] session storage failed")
TEXT(TXT_009,
"HEARTBEAT cycle. Review this checklist and act on anything actionable.\n"
        "If nothing needs action, reply exactly: HEARTBEAT_OK\n\n")
TEXT(TXT_010,
"(no goals yet - /goal add <task>)")
TEXT(TXT_011,
"usage: /goal | /goal add <task> | /goal done <id> | /goal rm <id>")
TEXT(TXT_012,
"{\n  \"_note\": \"written by clawc setup\",\n  \"workspace\": ")
TEXT(TXT_013,
",\n  \"api_url\": ")
TEXT(TXT_014,
",\n  \"api_key\": ")
TEXT(TXT_015,
",\n  \"telegram_token\": ")
TEXT(TXT_016,
",\n  \"telegram_allow\": ")
TEXT(TXT_017,
",\n  \"telegram_users\": ")
TEXT(TXT_018,
",\n  \"auto_approve\": true")
TEXT(TXT_019,
"Return only JSON: {\"report\":\"your visible response\",\"messages\":[{\"to\":\"@agent or #group\",\"text\":\"message\"}]}. Send no messages if finished.")
TEXT(TXT_020,
"Available agents:")
TEXT(TXT_021,
"{\"type\":\"object\",\"properties\":{")
TEXT(TXT_022,
",\"description\":")
